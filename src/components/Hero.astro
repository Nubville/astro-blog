---
interface Props {
  nameHeading?: 'h1' | 'h2';
}
const { nameHeading: NameTag = 'h1' } = Astro.props;
---

<section class="hero" aria-label="Site introduction">
  <sketch-card type="character" class="profile-card">
    <div class="card-content profile-content">
      <p class="profile-annotation">// profile card · v0.1</p>

      <div class="profile-body">
        <div class="portrait">
          <picture>
            <!-- Rendered width isn't monotonic with viewport — this card's
                 layout is container-query-driven (sketch-card breakpoints
                 at 420px/900px), not viewport-driven, and sizes can only
                 express the latter. These three tiers are measured, not
                 guessed: ~200px below 420px viewport width, ~750px in the
                 420-1399px single-column range, back down to ~300px once
                 the 1400px three-column spread kicks in. -->
            <source
              type="image/webp"
              srcset="/images/drew_avatar-300.webp 300w, /images/drew_avatar-600.webp 600w, /images/drew_avatar-900.webp 900w, /images/drew_avatar-1350.webp 1350w"
              sizes="(max-width: 419px) 200px, (min-width: 1400px) 300px, 750px"
            />
            <img
              src="/images/drew_avatar-fallback.jpg"
              alt="Andrew Garman — a generated illustration of the author as a css wizard with a mix of coding and dungeon master dice"
              width="900"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </div>

        <div class="profile-info">
          <NameTag class="profile-name">Andrew Garman</NameTag>
          <p class="profile-role">Senior Front-End Developer</p>

          <ul class="profile-tags" role="list" aria-label="Interests">
            <li class="tag tag--code">⌨ Code</li>
            <li class="tag tag--dnd">⚔ D&amp;D</li>
            <li class="tag tag--make">🖨 3D Print</li>
            <li class="tag tag--fish">🎣 Fishing</li>
            <li class="tag tag--kayak">🤖 IoT</li>
          </ul>
        </div>
      </div>
    </div>
  </sketch-card>
</section>

<style>
  .hero {
    margin-bottom: var(--ag-space-2xl);
  }

  /* No max-width here — the grid column constrains the card width */
  .profile-card {
    width: 100%;
  }

  .profile-content {
    padding: var(--ag-space-l) var(--ag-space-xl) var(--ag-space-xl);
  }

  .profile-annotation {
    border-bottom: solid var(--ag-border-width-m) var(--pencil);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.05em;
    padding-bottom: var(--ag-space-m);
    margin: 0 0 var(--ag-space-l);
  }

  /* Default: stacked — portrait above text */
  .profile-body {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: var(--ag-space-m);
  }

  .portrait {
    align-self: center;
    flex-shrink: 0;
    width: 100%;
  }

  .portrait img {
    display: block;
    height: auto;
    mix-blend-mode: multiply;
    width: 100%;
  }

  /* multiply only reads correctly against a light backdrop — on a
     dark surface it crushes this full-color illustration toward
     black, so it renders unblended there instead. Add new dark
     themes to this selector list too. */
  :global([data-theme='lamplight']) .portrait img,
  :global([data-theme='horde']) .portrait img {
    mix-blend-mode: normal;
  }

  .profile-info {
    flex: 1;
    min-width: 0;
  }

  .profile-name {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--ag-font-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    margin: 0 0 var(--ag-space-2xs);
  }

  .profile-role {
    color: var(--brand-1);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.1em;
    margin: 0 0 var(--ag-space-m);
    text-transform: uppercase;
  }

  /* Dark themes only: --brand-1 (a fill color, not a text-on-surface
     one) reads at ~3:1 against these themes' dark surfaces — fails
     WCAG AA's 4.5:1 for body text. --brand-3 is the same brand hue at
     the lighter on-surface rung each dark theme already defines. */
  :global([data-theme='lamplight']) .profile-role,
  :global([data-theme='horde']) .profile-role {
    color: var(--brand-3);
  }

  .profile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ag-space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    border: 1px solid var(--pencil);
    border-radius: 2px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.06em;
    padding: var(--ag-space-2xs) var(--ag-space-xs);
    text-transform: uppercase;
  }

  /* Dark themes only: same reasoning as sketch-card in global.css —
     a border alone doesn't separate a chip from a busy dark page the
     way it does on light paper. */
  :global([data-theme='lamplight']) .tag,
  :global([data-theme='horde']) .tag {
    background: var(--surface-raised);
  }

  .tag--code {
    border-color: var(--blue-ink);
    color: var(--blue-ink);
  }
  .tag--dnd {
    border-color: var(--brand-1);
    color: var(--brand-1);
  }

  /* Same --brand-1 contrast issue as .profile-role above, same fix. */
  :global([data-theme='lamplight']) .tag--dnd,
  :global([data-theme='horde']) .tag--dnd {
    border-color: var(--brand-3);
    color: var(--brand-3);
  }
  .tag--make {
    border-color: var(--amber-ink);
    color: var(--amber-ink);
  }
  .tag--fish,
  .tag--kayak {
    border-color: var(--green-ink);
    color: var(--green-ink);
  }

  /* Step 3: Container queries — card responds to its own width */

  /* Medium (420px+): portrait left, info right */
  @container sketch-card (min-width: 420px) {
    /* .profile-body {
      flex-direction: row;
      gap: var(--ag-space-l);
    } */

    .portrait {
      width: 100%;
    }
  }

  /* Wide (640px+): larger portrait, bigger name, unwrap tags */
  @container sketch-card (min-width: 640px) {
    .profile-body {
      gap: var(--ag-space-xl);
    }

    .profile-name {
      font-size: var(--ag-font-size-2xl);
    }

    .profile-tags {
      flex-wrap: nowrap;
    }
  }

  /* Hero (900px+): portrait tall left column, rich info right */
  @container sketch-card (min-width: 900px) {
    .profile-annotation {
      margin-bottom: 0;
    }

    .profile-body {
      flex-direction: column;
      gap: var(--ag-space-l);
    }

    .portrait {
      width: 100%;
    }
  }
</style>
