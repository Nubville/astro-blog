---
import Binding from '../components/Binding.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TagNav from '../components/TagNav.astro';
import '../styles/global.css';

import {
  DEFAULT_SOCIAL_IMAGE,
  DEFAULT_SOCIAL_IMAGE_ALT,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from '../consts';

interface Props {
  pageTitle: string;
  showPageTitle?: boolean;
  /** Search-result snippet and social-card body. Falls back to the site description. */
  description?: string;
  /** Social card image. Post layouts pass their frontmatter image. */
  image?: string;
  /** Alt text for the social card image. Post layouts pass their frontmatter image.alt. */
  imageAlt?: string;
  /** Posts are articles; everything else is a website. */
  type?: 'website' | 'article';
  /** Publication date, for article metadata. */
  pubDate?: string | Date;
  /**
   * Heading level for the author card's name in the persistent sidebar.
   * Only ever 'h1' on pages with no other h1 on the page (the homepage,
   * where showPageTitle is false and nothing else supplies one) — every
   * other page already gets its own h1 (page-title or the post's own
   * markdown heading), so the sidebar name stays an 'h2' there.
   */
  heroNameHeading?: 'h1' | 'h2';
}

const {
  pageTitle,
  showPageTitle = true,
  description = SITE_DESCRIPTION,
  image = DEFAULT_SOCIAL_IMAGE,
  imageAlt = DEFAULT_SOCIAL_IMAGE_ALT,
  type = 'website',
  pubDate,
  heroNameHeading = 'h2',
} = Astro.props;

// Titles read "Post name — Andrew Garman — Dev Blog", except the homepage,
// which already is the site title.
const title = pageTitle === SITE_TITLE ? pageTitle : `${pageTitle} — ${SITE_TITLE}`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Social scrapers reject relative paths, so every image is resolved to absolute.
const socialImage = new URL(image, Astro.site).href;

const publishedISO = pubDate ? new Date(pubDate).toISOString() : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Mirrors --ink from paper.css; meta[theme-color] can't reference a CSS custom property. -->
    <meta name="theme-color" content="#2a1e10" />

    <!-- Google Fonts are @imported from fonts.css; preconnect starts that
         connection before CSS parsing discovers it. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Open Graph — what LinkedIn, Discord, Slack and Bluesky read. -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={SITE_TITLE} />
    {publishedISO && <meta property="article:published_time" content={publishedISO} />}
    {type === 'article' && <meta property="article:author" content={SITE_AUTHOR} />}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Page-specific structured data (Person on /about, BlogPosting on posts). -->
    <slot name="head" />

    <!-- Plausible — privacy-friendly, no cookie banner needed. Confirm this
         domain matches whatever gets registered in the Plausible dashboard. -->
    <script
      is:inline
      defer
      data-domain="www.andrewgarman.com"
      src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <div class="site-layout">
      <Binding />

      <div class="content-col">
        <Header />
        <div class="content-container">
          <main>
            <aside class="hero-section" aria-label="Author profile and tag index">
              <Hero nameHeading={heroNameHeading} />
              <slot name="sidebar-extra" />
              <TagNav />
            </aside>

            {
              showPageTitle ? (
                <div class="page-content">
                  <h1 class="page-title">{pageTitle}</h1>
                  <slot />
                </div>
              ) : (
                <slot />
              )
            }
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>

<script>
  import '../custom-elements/sketch-card.js';
</script>

<style>
  .page-title {
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }
</style>
