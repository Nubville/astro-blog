---
import BaseLayout from './BaseLayout.astro';
import PostSidebar from '../components/PostSidebar.astro';
import { DEFAULT_SOCIAL_IMAGE, SITE_AUTHOR } from '../consts';

const { frontmatter } = Astro.props;

const postImage = frontmatter.image?.url ?? DEFAULT_SOCIAL_IMAGE;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: new URL(postImage, Astro.site).href,
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  author: { '@type': 'Person', name: frontmatter.author ?? SITE_AUTHOR },
  publisher: { '@type': 'Person', name: SITE_AUTHOR },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
};

type PostModule = {
  frontmatter: { title: string; pubDate: string | Date; type?: string };
  url: string;
};

const postModules = import.meta.glob<PostModule>('../pages/posts/*.md', { eager: true });
const recentPosts = Object.values(postModules)
  .filter(
    (p) => p.frontmatter.title !== frontmatter.title && p.frontmatter.type === frontmatter.type
  )
  .sort(
    (a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
  )
  .slice(0, 4)
  .map((p) => ({ title: p.frontmatter.title, pubDate: p.frontmatter.pubDate, url: p.url }));
---

<script>
  import '../custom-elements/code-copy.js';
</script>
{
  /* Note: frontmatter.type is the card category (spellbook/quest/lore), not the
    Open Graph type — a post is always an "article" for social scrapers. */
}
<BaseLayout
  pageTitle={frontmatter.title}
  showPageTitle={false}
  description={frontmatter.description}
  image={frontmatter.image?.url}
  imageAlt={frontmatter.image?.alt}
  type="article"
  pubDate={frontmatter.pubDate}
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(blogPostingSchema)}
  />

  <PostSidebar
    slot="sidebar-extra"
    posts={recentPosts}
    postsLabel={`// more ${frontmatter.type ?? 'posts'}`}
  />

  <article class="post-article">
    <header class="post-header">
      <p class="post-date">{frontmatter.pubDate.toString().slice(0, 10)}</p>
      <p class="post-description"><em>{frontmatter.description}</em></p>
      <p class="post-author">Written by: {frontmatter.author}</p>
      {
        frontmatter.image && (
          <img
            src={frontmatter.image.url}
            width={frontmatter.image.width}
            height={frontmatter.image.height}
            alt={frontmatter.image.alt}
          />
        )
      }
      <div class="tags">
        {
          frontmatter.tags.map((tag: string) => (
            <p class="tag">
              <a href={`/tags/${tag}`}>{tag}</a>
            </p>
          ))
        }
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>
<style>
  .post-article {
    grid-area: posts;
    max-width: 72ch;
    width: 100%;
    min-width: 0;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-date {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .post-description {
    color: var(--ink-faint);
    margin-bottom: 0.25rem;
  }

  .post-author {
    color: var(--ink-faint);
    font-size: var(--ag-font-size-s);
    margin-bottom: 1rem;
  }

  .post-header img {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tag {
    margin: 0;
    border: dotted 1px var(--pencil);
    border-radius: 0.5em;
    padding: 0.25em 0.75em;
    font-size: var(--ag-font-size-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  /* Dark themes only — see the matching comment in global.css on
     sketch-card for why. */
  [data-theme='lamplight'] .tag,
  [data-theme='horde'] .tag {
    background: var(--surface-raised);
  }

  .tag a {
    color: var(--ink-faint);
    text-decoration: none;

    &:hover {
      color: var(--brand-1);
    }
  }

  .post-body {
    line-height: 1.7;
  }

  .post-body :global(figure) {
    margin: 2rem 0;
  }

  .post-body :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-bottom: var(--ag-space-l);
  }

  .post-body :global(figcaption) {
    margin-top: 0.5rem;
    font-family: var(--font-annotation);
    font-size: var(--ag-font-size-s);
    color: var(--ink-faint);
  }

  .post-body :global(table) {
    border-collapse: collapse;
    font-size: var(--ag-font-size-s);
    margin-bottom: var(--ag-space-xl);
    width: 100%;
  }

  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid var(--pencil);
    padding: var(--ag-space-2xs) var(--ag-space-s);
    text-align: left;
  }

  .post-body :global(th) {
    background: var(--paper-dark);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-body :global(tr:nth-child(even) td) {
    background: var(--paper-dark);
  }
</style>
