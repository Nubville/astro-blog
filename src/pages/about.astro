---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS, SITE_AUTHOR } from '../consts';
import resume from '../data/resume.json';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_AUTHOR,
  jobTitle: resume.role,
  url: new URL('/about', Astro.site).href,
  sameAs: [LINKS.linkedin, LINKS.github].filter(Boolean),
};
---

<BaseLayout pageTitle="About" showPageTitle={false}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(personSchema)}
  />
  <div class="about-page">
    <!-- ── Profile header ──────────────────────────────── -->
    <header class="about-header">
      <div class="about-header-text">
        <p class="about-eyebrow">// about.md</p>
        <h1 class="about-name">{SITE_AUTHOR}</h1>
        <p class="about-role">{resume.role}</p>
        <p class="about-summary">{resume.summary}</p>
        <div class="about-actions">
          <a href={LINKS.linkedin} class="btn-primary" target="_blank" rel="noopener noreferrer">
            LinkedIn Profile
          </a>
          <a href="mailto:garman.andrew@gmail.com" class="btn-secondary">
            garman.andrew@gmail.com
          </a>
        </div>
      </div>
    </header>

    <!-- ── Skills ──────────────────────────────────────── -->
    <section class="about-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-heading">Technical Skills</h2>
      <dl class="skills-grid">
        {
          resume.skillGroups.map((group) => (
            <div class="skill-group">
              <dt class="skill-category">{group.category}</dt>
              <dd class="skill-tags">
                {group.tags.map((tag) => (
                  <span class={`skill-tag skill-tag--${group.style}`}>{tag}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ── Experience ──────────────────────────────────── -->
    <section class="about-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-heading">Experience</h2>
      <ol class="timeline" role="list">
        {
          resume.experience.map((job) => (
            <li class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-dates">{job.dates}</span>
              </div>
              <div class="timeline-body">
                <h3 class="timeline-role">{job.role}</h3>
                <p class="timeline-company">{job.company}</p>
                {job.summary && <p class="timeline-summary">{job.summary}</p>}
                <ul class="timeline-bullets">
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ── Education ───────────────────────────────────── -->
    <section class="about-section" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-heading">Education</h2>
      {
        resume.education.map((entry) => (
          <div class="education-item">
            <h3 class="education-degree">{entry.degree}</h3>
            <p class="education-school">{entry.school}</p>
            <p class="education-dates">{entry.dates}</p>
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 72ch;
    width: 100%;
  }

  /* ── Header ───────────────────────────────────────── */
  .about-header {
    border-bottom: 1.5px solid var(--ink);
    margin-bottom: var(--ag-space-2xl);
    padding: var(--ag-space-xl) 0 var(--ag-space-2xl);
  }

  .about-eyebrow {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.1em;
    margin: 0 0 var(--ag-space-xs);
  }

  .about-name {
    font-family: var(--font-display);
    font-size: var(--ag-font-size-4xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin: 0 0 var(--ag-space-2xs);
  }

  .about-role {
    color: var(--brand-1);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.12em;
    margin: 0 0 var(--ag-space-l);
    text-transform: uppercase;
  }

  .about-summary {
    color: var(--ink);
    font-size: var(--ag-font-size-m);
    line-height: 1.7;
    margin: 0 0 var(--ag-space-xl);
    max-width: 62ch;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ag-space-s);
  }

  .btn-primary {
    background: var(--ink);
    border: 1.5px solid var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.08em;
    padding: var(--ag-space-xs) var(--ag-space-l);
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background var(--ag-transition-fast),
      color var(--ag-transition-fast);

    &:hover {
      background: var(--brand-1);
      border-color: var(--brand-1);
      color: var(--paper);
    }

    &:focus-visible {
      outline: 2px solid var(--brand-1);
      outline-offset: 3px;
    }
  }

  .btn-secondary {
    border: 1.5px solid var(--pencil);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.06em;
    padding: var(--ag-space-xs) var(--ag-space-l);
    text-decoration: none;

    &:hover {
      border-color: var(--ink);
      color: var(--ink);
    }

    &:focus-visible {
      outline: 2px solid var(--brand-1);
      outline-offset: 3px;
    }
  }

  /* ── Shared section styles ────────────────────────── */
  .about-section {
    margin-bottom: var(--ag-space-3xl);
  }

  .section-heading {
    border-bottom: 1px solid var(--pencil);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    font-weight: var(--font-weight-regular);
    letter-spacing: 0.14em;
    margin: 0 0 var(--ag-space-l);
    padding-bottom: var(--ag-space-2xs);
    text-transform: uppercase;
  }

  /* ── Skills ───────────────────────────────────────── */
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: var(--ag-space-m);
  }

  .skill-group {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ag-space-xs);
  }

  .skill-category {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.06em;
    min-width: 9rem;
    text-transform: uppercase;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ag-space-2xs);
    margin: 0;
    padding: 0;
  }

  .skill-tag {
    border: 1px solid var(--pencil);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.04em;
    padding: 2px var(--ag-space-xs);
  }

  .skill-tag--code {
    border-color: var(--blue-ink);
    color: var(--blue-ink);
  }
  .skill-tag--design {
    border-color: var(--amber-ink);
    color: var(--amber-ink);
  }
  .skill-tag--standard {
    border-color: var(--green-ink);
    color: var(--green-ink);
  }
  .skill-tag--ai {
    border-color: var(--brand-1);
    color: var(--brand-1);
  }

  /* ── Timeline ─────────────────────────────────────── */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline-item {
    border-left: 2px solid var(--pencil);
    display: grid;
    gap: var(--ag-space-xs) var(--ag-space-xl);
    grid-template-columns: 9rem 1fr;
    padding: 0 0 var(--ag-space-2xl) var(--ag-space-l);
    position: relative;

    /* dot on the timeline rail */
    &::before {
      background: var(--ink);
      border-radius: 50%;
      content: '';
      height: 8px;
      left: -5px;
      position: absolute;
      top: 6px;
      width: 8px;
    }

    &:last-child {
      border-left-color: transparent;
    }
  }

  .timeline-meta {
    padding-top: 2px;
  }

  .timeline-dates {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .timeline-role {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--ag-font-size-m);
    font-weight: var(--font-weight-regular);
    margin: 0 0 2px;
  }

  .timeline-company {
    color: var(--brand-1);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.04em;
    margin: 0 0 var(--ag-space-xs);
  }

  .timeline-summary {
    color: var(--ink-faint);
    font-size: var(--ag-font-size-s);
    line-height: 1.6;
    margin: 0 0 var(--ag-space-xs);
  }

  .timeline-bullets {
    color: var(--ink);
    display: flex;
    flex-direction: column;
    font-size: var(--ag-font-size-s);
    gap: var(--ag-space-2xs);
    line-height: 1.5;
    margin: 0;
    padding-left: var(--ag-space-l);
  }

  /* ── Responsive: collapse timeline to single col ──── */
  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 1fr;
    }

    .skill-category {
      min-width: 100%;
    }
  }

  /* ── Education ────────────────────────────────────── */
  .education-item {
    border-left: 2px solid var(--pencil);
    padding-left: var(--ag-space-l);

    & + & {
      margin-top: var(--ag-space-l);
    }
  }

  .education-degree {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--ag-font-size-m);
    font-weight: var(--font-weight-regular);
    margin: 0 0 2px;
  }

  .education-school {
    color: var(--brand-1);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .education-dates {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: var(--ag-font-size-xs);
    margin: 2px 0 0;
  }
</style>
